# Loaded by `vite build --mode e2e` (see `pnpm build:e2e`, playwright.config.ts).
# Committed on purpose — no secret, just the flags that make the e2e build
# deterministic. Never hand-edit `.env.local` to set these; they aren't meant
# for a real deploy.
VITE_E2E=true

# Vite loads the base `.env` for every mode, `.env.e2e` on top of it — pin this
# to empty explicitly so the e2e build is same-origin (MSW-intercepted) no
# matter what a developer's own local `.env`/`.env.local` sets it to for their
# own unrelated dev-against-a-real-backend workflow.
VITE_API_BASE_URL=

# Same reasoning as VITE_API_BASE_URL above: pin explicitly so a developer's own
# `.env.local` (e.g. VITE_ENABLE_MOCKS=false, for their own dev-against-a-real-backend
# workflow) can never silently disable MSW in the e2e build — the whole smoke-gate
# depends on the MSW-backed fetch actually happening (see e2e/smoke.spec.ts).
VITE_ENABLE_MOCKS=true
