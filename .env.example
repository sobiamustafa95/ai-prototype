# Copy to `.env.local` and adjust per environment. Never commit real secrets.

# Host for the API client (src/services/api-client.ts). Leave empty for same-origin
# (dev + tests use MSW). Set to e.g. https://api.example.com in real environments.
# Route paths already include "/api/v1/..." so this is host-only.
VITE_API_BASE_URL= Your BE BASE URL

# Toggle MSW mocked network in dev (true keeps the app runnable with no backend).
VITE_ENABLE_MOCKS=true
