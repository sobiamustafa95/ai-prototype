{
  "name": "geeks-fe-boilerplate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Company-wide, domain-agnostic, production-grade React + Vite boilerplate for Geeks.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm check:format",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,json,md,css}\"",
    "doctor": "react-doctor src/",
    "ai:sync": "node scripts/sync-ai-config.mjs",
    "ai:check": "node scripts/checks/ai-config-contract.mjs",
    "check:guardrails": "node scripts/checks/guard-rails.mjs",
    "check:lint-contract": "node scripts/checks/lint-config-contract.mjs",
    "lint:check": "eslint . --max-warnings=0",
    "static-analysis:contract": "node scripts/check-static-analysis.mjs",
    "check:types": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:test": "pnpm test:run",
    "check:lint": "eslint . --max-warnings=0",
    "check:a11y": "eslint --config eslint.a11y.config.js \"src/**/*.tsx\" --max-warnings=0",
    "check:format": "prettier --check \"src/**/*.{ts,tsx,json,md,css}\"",
    "check:style": "impeccable detect src/ < /dev/null",
    "check:doctor": "react-doctor src/ --no-supply-chain --yes < /dev/null",
    "check:build": "pnpm build",
    "typecheck": "pnpm check:types",
    "style:check": "pnpm check:style",
    "verify": "pnpm check:guardrails && pnpm static-analysis:contract && pnpm ai:check && pnpm check:lint-contract && pnpm check:types && pnpm check:test && pnpm check:lint && pnpm check:a11y && pnpm check:format && pnpm check:style && pnpm check:doctor && pnpm check:build",
    "gate": "node scripts/hooks/pre-commit.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.{js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "impeccable": "^3.6.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
